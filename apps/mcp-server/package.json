{
  "name": "@lifeos/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "LifeOS MCP server — Streamable HTTP transport, MCP spec 2025-11-25",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/__tests__/mcp-integration.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lifeos/shared": "workspace:*",
    "@lifeos/database": "workspace:*",
    "@lifeos/ai": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
