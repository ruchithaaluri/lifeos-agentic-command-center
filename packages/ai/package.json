{
  "name": "@lifeos/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic LLM abstraction and agent orchestration for LifeOS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lifeos/shared": "workspace:*",
    "openai": "^4.56.0",
    "@anthropic-ai/sdk": "^0.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^22.5.0",
    "vitest": "^2.0.5"
  }
}
