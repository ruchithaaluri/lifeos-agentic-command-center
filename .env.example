# =============================================================
# LifeOS Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================

# --- Database ---
# PostgreSQL connection string
# Docker default password is "postgres" (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos"

# --- AI Provider ---
# Supported providers: openai | anthropic
# Leave AI_API_KEY empty to use the rule-based fallback (no API key required for demo)
AI_PROVIDER="openai"
AI_MODEL="gpt-4o"
AI_API_KEY=""

# --- MCP Server ---
# URL where the MCP server is running
MCP_SERVER_URL="http://localhost:3001"
# Secret bearer token for MCP server authentication (min 32 chars)
MCP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- NextAuth (Web App) ---
# Generate with: openssl rand -base64 32
# Required for sign-in/sign-up. The app falls back to demo mode only when
# DEMO_MODE=true, so these only matter for real accounts.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# --- Demo Mode ---
# Set to "true" to auto-login as demo user and use seeded data
DEMO_MODE="true"
DEMO_USER_ID="00000000-0000-0000-0000-000000000001"
DEMO_USER_EMAIL="alex.chen@lifeos.demo"

# --- Abuse protection (optional) ---
# Fixed-window in-process limits. Generous defaults for local dev/demo.
# Signups per IP per hour.
SIGNUP_RATE_LIMIT="5"
# Credential attempts per IP per 15 min.
LOGIN_RATE_LIMIT_IP="10"
# Credential attempts per email per 15 min (stops distributed attacks on one account).
LOGIN_RATE_LIMIT_EMAIL="5"

# --- CORS (MCP Server) ---
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000"

# --- Logging ---
LOG_LEVEL="info"
NODE_ENV="development"
